# ==============================================================================
# GoCars Backend Environment Variables Template
# ==============================================================================

# Application Metadata
PROJECT_NAME="GoCars API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Authentication
# In production, generate a secure secret key: openssl rand -hex 32
SECRET_KEY="gocars-insecure-development-secret-key-change-in-production"
JWT_SECRET_KEY="replace_with_a_secure_random_jwt_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/gocars_db"

# Supabase Credentials (Cloud Database & Storage)
SUPABASE_URL="https://ubpztwyowttvyvtbpzlq.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_jG_cmTA16xhBSTVCu3hRQw_FjTFBGW4"
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://ubpztwyowttvyvtbpzlq.supabase.co/auth/v1/.well-known/jwks.json"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
